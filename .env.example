# DevWorld local development — copy to .env (never commit real secrets).
# Names and inert examples only; production secrets come from a secret manager.
DEVWORLD_APP_ORIGIN=http://127.0.0.1:5173
DEVWORLD_DATABASE_URL=sqlite:///./devworld.db
DEVWORLD_REDIS_URL=redis://127.0.0.1:6379/0
DEVWORLD_OBJECT_ENDPOINT=http://127.0.0.1:9000
DEVWORLD_OBJECT_BUCKET=devworld-artifacts
DEVWORLD_KMS_KEY_ID=local-inert-key
DEVWORLD_GITHUB_APP_ID=
DEVWORLD_GITHUB_CLIENT_ID=
DEVWORLD_GITHUB_CLIENT_SECRET=
DEVWORLD_GITHUB_PRIVATE_KEY_REF=
DEVWORLD_GITHUB_WEBHOOK_SECRET=test-webhook-secret
DEVWORLD_GITHUB_API_VERSION=2022-11-28
DEVWORLD_DEMO_MODE=true
DEVWORLD_SHARE_ENABLED=false
VITE_DEVWORLD_API_BASE=/api/v1
